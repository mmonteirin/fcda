# ─── .env (vai para o git) ───────────────────────────────────────────────────
# Variáveis públicas — sem segredos.

SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXXXXXX

VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXXXXXX
VITE_SUPABASE_PROJECT_ID=SEU_PROJECT_ID

# Sentry (monitoramento de erros) - opcional
VITE_SENTRY_DSN=


# ─── .env.local (NÃO vai para o git — coberto por *.local) ──────────────────
# Copie as linhas abaixo para um arquivo chamado .env.local

# SUPABASE_SERVICE_ROLE_KEY=sb_secret_XXXXXXXXXXXXXXXXXXXXXXXX

# Sentry (para upload de source maps) - opcional
# SENTRY_AUTH_TOKEN=sntrys_XXXXXXXXXXXXXXXXXXXXXXXX
# SENTRY_ORG=your-org
# SENTRY_PROJECT=your-project
